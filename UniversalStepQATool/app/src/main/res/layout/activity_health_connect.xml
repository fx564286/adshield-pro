<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Health Connect 권한 진단 v6"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hcStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="상태: 확인 중"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hcPermissionState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#EEEEEE"
            android:padding="10dp"
            android:text="권한 상태 확인 중..."
            android:textIsSelectable="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="권한 요청을 두 번 취소한 뒤에는 Android가 팝업을 다시 표시하지 않을 수 있습니다. 그 경우 아래 '권한 설정 직접 열기'에서 READ_STEPS를 허용하세요." />

        <Button
            android:id="@+id/hcCheckButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="0. 현재 권한 상태 재검사" />

        <Button
            android:id="@+id/hcPermissionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. READ_STEPS 권한 요청" />

        <Button
            android:id="@+id/hcManageAccessButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. 이 앱의 Health Connect 권한 설정 직접 열기" />

        <Button
            android:id="@+id/hcReadButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3. 오늘 Health Connect 걸음 조회" />

        <Button
            android:id="@+id/hcBackButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="메인 화면으로 돌아가기" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="연동 로그"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hcLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="220dp"
            android:paddingTop="6dp"
            android:textIsSelectable="true"
            android:textSize="13sp"
            android:typeface="monospace" />

    </LinearLayout>
</ScrollView>
