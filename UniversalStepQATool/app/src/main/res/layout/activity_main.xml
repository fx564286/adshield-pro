<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Universal Step QA Tool v9"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="상태: 시작됨"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/platformInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textIsSelectable="true" />

        <TextView
            android:id="@+id/actualSessionView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:padding="12dp"
            android:text="실제 걷기 세션: 0 보"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/selfTestButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="0. 실제 센서 자체 점검" />

        <Button
            android:id="@+id/sensorButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. 실제 센서 진단 시작" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="실제 걷기는 STEP_DETECTOR, STEP_COUNTER 증가량, 실제 가속도계 보행 검출을 동시에 비교합니다. 걸음 센서가 0이어도 가속도계 폴백이 계속 작동합니다." />

        <Button
            android:id="@+id/virtualShakeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="2. 가상 흔들림 QA 시작" />

        <Button
            android:id="@+id/autoButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3. 자동 QA 카운터 시작" />

        <TextView
            android:id="@+id/localCountView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="QA 테스트 카운트: 0 보"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/add100Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="+100" />

            <Button
                android:id="@+id/add1000Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="+1000" />

            <Button
                android:id="@+id/resetButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="QA 초기화" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="가상/자동 QA 값은 실제 걷기 세션과 완전히 분리됩니다." />

        <Button
            android:id="@+id/healthConnectButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="4. Health Connect 읽기/권한 진단" />

        <TextView
            android:id="@+id/sensorInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="센서: 미확인"
            android:textIsSelectable="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="실행 로그"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/logView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="160dp"
            android:paddingTop="6dp"
            android:textIsSelectable="true"
            android:textSize="13sp"
            android:typeface="monospace" />

    </LinearLayout>
</ScrollView>
